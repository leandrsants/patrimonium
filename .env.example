# Copie este arquivo para .env.local e preencha com os valores do Supabase LOCAL
# (rode `supabase start` e use os valores impressos: API URL e service_role key).
# NUNCA versione .env.local nem cole segredos reais aqui.

# URL da API do Supabase local (padrão do `supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave service_role — usada SOMENTE no servidor (src/lib/supabase/server.ts).
# Sem ela, createServerSupabaseClient() retorna null e as páginas mostram
# "empresa não cadastrada no banco local".
SUPABASE_SERVICE_ROLE_KEY=

# Chave anon (reservada para quando existir cliente no browser / login real).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
